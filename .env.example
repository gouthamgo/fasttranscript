# ---------------------------------------------------------------------------
# FastTranscript configuration. Every value below has a working default;
# set them explicitly before deploying.
# ---------------------------------------------------------------------------

# Pepper for the API-key HMAC. MUST be set in production and MUST be identical
# across every instance, or previously issued keys stop verifying.
# Generate with: openssl rand -hex 32
FT_KEY_SECRET=

# Where API keys and usage counters are persisted. Must be a writable volume
# that survives restarts. On a read-only or ephemeral filesystem the app falls
# back to memory and warns loudly.
FT_DATA_DIR=./.data

# Number of reverse proxies in front of this app. Used to pick the correct
# entry from X-Forwarded-For when rate limiting.
#   0 = no proxy; ignore X-Forwarded-For entirely (default, and the safe choice)
#   1 = one proxy (nginx, Caddy, a single load balancer)
# Setting this too high lets a client forge its own identity and bypass limits.
# Vercel and Cloudflare are detected automatically and need no value here.
FT_TRUST_PROXY_HOPS=0

# Anonymous requests per minute for the web app endpoint (/api/extract).
FT_ANON_RATE_PER_MINUTE=15

# New API keys issuable per hour per IP. Without a cap, the free-tier quota is
# meaningless: a caller can simply mint another key.
FT_KEY_ISSUE_PER_HOUR=3

# Deadline for any single outbound request to YouTube, in milliseconds.
FT_UPSTREAM_TIMEOUT_MS=8000

# Transcript cache tuning.
FT_CACHE_TTL_MS=604800000
FT_NEGATIVE_CACHE_TTL_MS=600000
FT_CACHE_MAX_BYTES=268435456
FT_CACHE_MAX_ENTRIES=10000

# ---------------------------------------------------------------------------
# SEO / canonical URLs
# ---------------------------------------------------------------------------
# Absolute public origin. Used for canonical tags, OpenGraph URLs and the
# sitemap. Getting this wrong silently costs indexing.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ---------------------------------------------------------------------------
# Billing (Stripe). Leave blank to run without payments — the pricing page
# then says "Billing not connected yet" instead of showing a dead button.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Without it, ANY unauthenticated POST could upgrade a key for free,
# so the webhook route refuses to run when it is unset.
STRIPE_WEBHOOK_SECRET=
# Recurring Price ids (price_...) for each paid plan.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
